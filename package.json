{
  "name": "diary",
  "version": "1.0.0",
  "description": "专为工作与生活足迹记录打造的 macOS 桌面手帐与 DeepSeek 智能周报助手",
  "author": "likeashot",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "TZ=Asia/Shanghai vite",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --bundle --platform=node --external:electron --external:sql.js --format=cjs",
    "electron": "wait-on http://localhost:5173 && TZ=Asia/Shanghai electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
